<?xml version="1.0"?>
<sdf version="1.8">
  <model name="tcp_pivot_fixture">
    <static>true</static>
    <link name="pivot_fixture">
      <!-- The MODEL origin is exactly the virtual pivot point. Decorative geometry
           is BELOW the origin. No collision: contact would perturb robot control. -->
      <visual name="tip"><pose>0 0 -0.04 0 0 0</pose>
        <geometry><mesh><uri>model://zhishu_robot_tcp_calibration/models/unit_cone.stl</uri><scale>0.012 0.012 0.04</scale></mesh></geometry>
        <material><ambient>1 0.65 0.1 1</ambient><diffuse>1 0.65 0.1 1</diffuse></material>
      </visual>
      <visual name="support"><pose>0 0 -0.14 0 0 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.20</length></cylinder></geometry>
        <material><ambient>0.85 0.2 0.08 1</ambient><diffuse>0.85 0.2 0.08 1</diffuse></material>
      </visual>
      <visual name="base"><pose>0 0 -0.255 0 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.18 0.18 0.22 1</ambient><diffuse>0.18 0.18 0.22 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
