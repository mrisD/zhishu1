<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo Sim only creates dynamic links that have valid inertial data.
         Without this block the finger links, their prismatic joints, and the
         corresponding ros2_control command interfaces are omitted from SDF. -->
    <xacro:macro name="gripper_finger_inertial">
        <inertial>
            <!-- 275 mm fingers reach the lower edge of the tote handle when
                 the TCP stays in the arm's reachable upper hook pose. -->
            <origin xyz="0 0 0.1375" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia
                ixx="0.000660208" ixy="0.0" ixz="0.0"
                iyy="0.000631042" iyz="0.0"
                izz="0.000036667"/>
        </inertial>
    </xacro:macro>

    <link name="gripper_base_link">
        <visual>
            <geometry>
                <box size="0.2 0.06 0.02"/>
            </geometry>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <material name="dark_green"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.2 0.06 0.02"/>
            </geometry>
            <origin xyz="0 0 0.008" rpy="0 0 0"/>
        </collision>
    </link>

    <link name="gripper_left_finger_link">
        <xacro:gripper_finger_inertial/>
        <visual>
            <geometry>
                <box size="0.02 0.06 0.275"/>
            </geometry>
            <origin xyz="0 0 0.1375" rpy="0 0 0"/>
            <material name="light_green"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.06 0.275"/>
            </geometry>
            <origin xyz="0 0 0.1375" rpy="0 0 0"/>
        </collision>
    </link>

    <link name="gripper_right_finger_link">
        <xacro:gripper_finger_inertial/>
        <visual>
            <geometry>
                <box size="0.02 0.06 0.275"/>
            </geometry>
            <origin xyz="0 0 0.1375" rpy="0 0 0"/>
            <material name="light_green"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.02 0.06 0.275"/>
            </geometry>
            <origin xyz="0 0 0.1375" rpy="0 0 0"/>
        </collision>
        <!-- Broad low hook pad on the inner/right finger.  The vertical finger
             reaches the aperture's lower edge; this pad provides a positive
             bearing surface behind the real handle rail during the pull. -->
        <visual>
            <geometry>
                <box size="0.06 0.12 0.02"/>
            </geometry>
            <!-- Shift inward from the right finger's +X joint offset so the
                 pad actually overlaps the tote's 120 mm handle rail. -->
            <origin xyz="-0.115 -0.04 0.238" rpy="0 0 0"/>
            <material name="light_green"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.06 0.12 0.02"/>
            </geometry>
            <origin xyz="-0.115 -0.04 0.238" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="gripper_left_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_left_finger_link"/>
        <origin xyz="-0.07 0 0.02" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <!-- Allow a small state-estimation/controller settling margin around
             the physical 60 mm stroke; the close command still targets the
             real 0..60 mm range. -->
        <limit effort="1000.0" velocity="1.0" lower="-0.01" upper="0.07"/>
    </joint>

    <joint name="gripper_right_finger_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_right_finger_link"/>
        <origin xyz="0.07 0 0.02" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <mimic joint="gripper_left_finger_joint" multiplier="-1.0"/>
        <limit effort="1000.0" velocity="1.0" lower="-0.07" upper="0.01"/>
    </joint>

    <link name="right_gripper_tcp"/>

    <joint name="right_gripper_tcp_joint" type="fixed">
        <parent link="gripper_base_link"/>
        <child link="right_gripper_tcp"/>
        <origin xyz="0 0 0.18" rpy="1.5708 0 0"/>
    </joint>
    <!-- Left gripper: same geometry and kinematics as the right gripper, but with left_* names. -->
    <link name="left_gripper_base_link">
        <!-- Keep the logical gripper joints in hand-eye mode so the shared
             SRDF and ros2_control configuration remain valid, but remove the
             physical tool from both rendering and collision checking. -->
        <xacro:unless value="$(arg handeye_target_enabled)">
            <visual>
                <geometry>
                    <box size="0.2 0.06 0.02"/>
                </geometry>
                <origin xyz="0 0 0.01" rpy="0 0 0"/>
                <material name="dark_green"/>
            </visual>
            <collision>
                <geometry>
                    <box size="0.2 0.06 0.02"/>
                </geometry>
                <origin xyz="0 0 0.008" rpy="0 0 0"/>
            </collision>
        </xacro:unless>
    </link>

    <link name="left_gripper_left_finger_link">
        <xacro:gripper_finger_inertial/>
        <xacro:unless value="$(arg handeye_target_enabled)">
            <visual>
                <geometry>
                    <box size="0.02 0.06 0.275"/>
                </geometry>
                <origin xyz="0 0 0.1375" rpy="0 0 0"/>
                <material name="light_green"/>
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.06 0.275"/>
                </geometry>
                <origin xyz="0 0 0.1375" rpy="0 0 0"/>
            </collision>
        </xacro:unless>
    </link>

    <link name="left_gripper_right_finger_link">
        <xacro:gripper_finger_inertial/>
        <xacro:unless value="$(arg handeye_target_enabled)">
            <visual>
                <geometry>
                    <box size="0.02 0.06 0.275"/>
                </geometry>
                <origin xyz="0 0 0.1375" rpy="0 0 0"/>
                <material name="light_green"/>
            </visual>
            <collision>
                <geometry>
                    <box size="0.02 0.06 0.275"/>
                </geometry>
                <origin xyz="0 0 0.1375" rpy="0 0 0"/>
            </collision>
        </xacro:unless>
    </link>

    <joint name="left_gripper_left_finger_joint" type="prismatic">
        <parent link="left_gripper_base_link"/>
        <child link="left_gripper_left_finger_link"/>
        <origin xyz="-0.07 0 0.02" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit effort="1000.0" velocity="1.0" lower="-0.01" upper="0.07"/>
    </joint>

    <joint name="left_gripper_right_finger_joint" type="prismatic">
        <parent link="left_gripper_base_link"/>
        <child link="left_gripper_right_finger_link"/>
        <origin xyz="0.07 0 0.02" rpy="0 0 0"/>
        <axis xyz="1 0 0"/>
        <mimic joint="left_gripper_left_finger_joint" multiplier="-1.0"/>
        <limit effort="1000.0" velocity="1.0" lower="-0.07" upper="0.01"/>
    </joint>

    <link name="left_gripper_tcp"/>
    <joint name="left_gripper_tcp_joint" type="fixed">
        <parent link="left_gripper_base_link"/>
        <child link="left_gripper_tcp"/>
        <origin xyz="0 0 0.18" rpy="1.5708 0 0"/>
    </joint>
</robot>
