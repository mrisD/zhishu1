<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find zhishu_robot_description)/urdf/handeye_target_pattern.xacro"/>
  <!-- Add the REP-103 optical frame and, in simulation, an RGB-D sensor with
       the same aligned color/depth geometry used by the Gemini Pro driver.
       Gazebo cameras look along camera_link +X; this fixed rotation exposes
       the conventional optical +Z-forward frame. -->
  <xacro:macro name="head_camera_sensor" params="enabled">
    <link name="head_camera_optical_frame"/>
    <xacro:if value="${enabled}">
      <!-- Simulation-only overhead bracket.  The real robot keeps the
           calibrated head_camera_link transform below; Gazebo instead places
           the same Gemini topic/frame contract above the work surface so the
           complete RGB-D grasp pipeline is deterministic.  Gazebo cameras
           look along +X, and +pi/2 about Y maps +X to world -Z. -->
      <link name="head_camera_sim_mount"/>
      <joint name="head_camera_sim_mount_joint" type="fixed">
        <parent link="base_link"/>
        <child link="head_camera_sim_mount"/>
        <origin xyz="0.62 0 1.75" rpy="0 ${pi / 2} 0"/>
      </joint>
      <joint name="head_camera_optical_joint" type="fixed">
        <parent link="head_camera_sim_mount"/>
        <child link="head_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="-${pi / 2} 0 -${pi / 2}"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${enabled}">
      <joint name="head_camera_optical_joint" type="fixed">
        <parent link="head_camera_link"/>
        <child link="head_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="-${pi / 2} 0 -${pi / 2}"/>
      </joint>
    </xacro:unless>

    <!-- Keep a coincident, read-only simulation truth frame.  The MoveIt
         HandEye RViz panel intentionally publishes its current camera-pose
         guess on head_camera_optical_frame, so that public calibration frame
         cannot also be used as an independent ground-truth reference. -->
    <link name="head_camera_optical_truth"/>
    <xacro:if value="${enabled}">
      <joint name="head_camera_optical_truth_joint" type="fixed">
        <parent link="head_camera_sim_mount"/>
        <child link="head_camera_optical_truth"/>
        <origin xyz="0 0 0" rpy="-${pi / 2} 0 -${pi / 2}"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${enabled}">
      <joint name="head_camera_optical_truth_joint" type="fixed">
        <parent link="head_camera_link"/>
        <child link="head_camera_optical_truth"/>
        <origin xyz="0 0 0" rpy="-${pi / 2} 0 -${pi / 2}"/>
      </joint>
    </xacro:unless>

    <xacro:if value="${enabled}">
      <gazebo reference="head_camera_sim_mount">
        <sensor name="head_gemini_pro_rgbd" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <!-- Gazebo appends /image, /depth_image, /points and /camera_info.
               ros_gz_bridge remaps these onto the real Orbbec topic names. -->
          <topic>/camera_head/rgbd</topic>
          <frame_id>head_camera_optical_frame</frame_id>
          <camera name="head_gemini_pro_rgbd">
            <optical_frame_id>head_camera_optical_frame</optical_frame_id>
            <!-- Closely matches the calibrated 640x480 Gemini Pro RGB K. -->
            <horizontal_fov>1.233</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.0005</stddev>
            </noise>
            <depth_camera>
              <clip>
                <near>0.10</near>
                <far>4.0</far>
              </clip>
            </depth_camera>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>

  <!-- The physical calibration plate replaces the left gripper only while
       hand-eye mode is enabled.  Dimensions and hole locations below are
       estimated from the supplied photograph after rectifying it against the
       known 30 mm ChArUco squares.  The ChArUco pattern frame remains at the
       pattern center, with local -X as the printed/camera-facing side. -->
  <xacro:macro name="left_handeye_target" params="enabled">
    <xacro:if value="${enabled}">
      <link name="handeye_target_truth">
        <inertial>
          <origin xyz="0 0 -0.020" rpy="0 0 0"/>
          <mass value="0.43"/>
          <inertia ixx="0.0037983" ixy="0" ixz="0"
                   iyy="0.0017347" iyz="0" izz="0.0020643"/>
        </inertial>
        <collision>
          <origin xyz="0 0 -0.020" rpy="0 0 0"/>
          <geometry><box size="0.003 0.240 0.220"/></geometry>
        </collision>
        <!-- Generated box geometry is used instead of a texture so the
             detector also works with the headless OGRE renderer. -->
        <xacro:handeye_target_pattern/>

        <!-- Photo-estimated 5.5 mm flange holes.  URDF has no subtraction
             primitive, so these thin dark discs are visual alignment marks;
             the collision model remains one conservative plate box. -->
        <visual name="handeye_mount_hole_1">
          <origin xyz="-0.0017 -0.0207 -0.0912" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder radius="0.00275" length="0.0004"/></geometry>
          <material name="handeye_hole"><color rgba="0.35 0.35 0.35 1"/></material>
        </visual>
        <visual name="handeye_mount_hole_2">
          <origin xyz="-0.0017 -0.0206 -0.1226" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder radius="0.00275" length="0.0004"/></geometry>
          <material name="handeye_hole"><color rgba="0.35 0.35 0.35 1"/></material>
        </visual>
        <visual name="handeye_mount_hole_3">
          <origin xyz="-0.0017 0.0213 -0.0985" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder radius="0.00275" length="0.0004"/></geometry>
          <material name="handeye_hole"><color rgba="0.35 0.35 0.35 1"/></material>
        </visual>
        <visual name="handeye_mount_hole_4">
          <origin xyz="-0.0017 0.0214 -0.1152" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder radius="0.00275" length="0.0004"/></geometry>
          <material name="handeye_hole"><color rgba="0.35 0.35 0.35 1"/></material>
        </visual>
      </link>
      <joint name="handeye_target_mount_joint" type="fixed">
        <parent link="L_hand_link"/>
        <child link="handeye_target_truth"/>
        <!-- The four-hole centroid is aligned with the flange origin.  The
             L_hand_link mesh extends into -Z, so its free flange side is +Z.
             The plate back (+X) touches z=0 and the printed face (-X) points
             outward along L_hand_link +Z toward the head camera. -->
        <origin xyz="0.1069 -0.0004 0.0015" rpy="0 ${pi / 2} 0"/>
      </joint>
    </xacro:if>
  </xacro:macro>
</robot>
