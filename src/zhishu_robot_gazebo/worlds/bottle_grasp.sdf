<?xml version="1.0"?>
<sdf version="1.9">
  <world name="bottle_grasp">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <physics name="bottle_grasp_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.82 0.90 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A stationary conveyor surface. Bottle motion is commanded by the
         VelocityControl plugin so tests can vary speed deterministically. -->
    <model name="conveyor_table">
      <static>true</static>
      <pose>0.66 0 1.05 0 0 0</pose>
      <link name="table_link">
        <collision name="top_collision"><geometry><box><size>0.78 0.86 0.10</size></box></geometry></collision>
        <visual name="top_visual"><geometry><box><size>0.78 0.86 0.10</size></box></geometry>
          <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
        </visual>
        <collision name="leg_collision"><pose>0 0 -0.52 0 0 0</pose><geometry><box><size>0.10 0.10 0.95</size></box></geometry></collision>
        <visual name="leg_visual"><pose>0 0 -0.52 0 0 0</pose><geometry><box><size>0.10 0.10 0.95</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.30 0.30 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Deliberately bottle-like geometry: body, shoulder, neck, cap and
         contrasting label improve transfer from COCO pretrained segmentation. -->
    <model name="bottle">
      <pose>0.62 -0.31 1.22 0 0 0</pose>
      <link name="bottle_link">
        <inertial>
          <mass>0.38</mass>
          <inertia><ixx>0.00165</ixx><iyy>0.00165</iyy><izz>0.00024</izz></inertia>
        </inertial>
        <collision name="body_collision">
          <geometry><cylinder><radius>0.036</radius><length>0.24</length></cylinder></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="body_visual"><pose>0 0 -0.018 0 0 0</pose>
          <geometry><cylinder><radius>0.036</radius><length>0.190</length></cylinder></geometry>
          <material><ambient>0.75 0.03 0.03 1</ambient><diffuse>0.90 0.05 0.05 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
        </visual>
        <visual name="label_visual"><pose>0 0 -0.015 0 0 0</pose>
          <geometry><cylinder><radius>0.0365</radius><length>0.070</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="shoulder_visual"><pose>0 0 0.078 0 0 0</pose>
          <geometry><sphere><radius>0.036</radius></sphere></geometry>
          <material><ambient>0.75 0.03 0.03 1</ambient><diffuse>0.90 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="neck_visual"><pose>0 0 0.102 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.045</length></cylinder></geometry>
          <material><ambient>0.75 0.03 0.03 1</ambient><diffuse>0.90 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="cap_visual"><pose>0 0 0.127 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.016</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <initial_linear>0 0.055 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
        <topic>/bottle/cmd_vel</topic>
      </plugin>
    </model>

    <!-- An obstacle is included now so the later PointCloud2 -> OctoMap path
         can be exercised without changing the world or acceptance test. -->
    <model name="obstacle_box">
      <static>true</static>
      <pose>0.48 0.24 1.25 0 0 0.20</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.16 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.16 0.30</size></box></geometry>
          <material><ambient>0.02 0.18 0.70 1</ambient><diffuse>0.04 0.25 0.90 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
