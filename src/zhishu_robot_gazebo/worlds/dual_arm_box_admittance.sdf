<?xml version="1.0"?>
<sdf version="1.9">
  <world name="admittance_box">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-bullet-featherstone-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.72 0.80 0.90 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 8 0 0 0</pose>
      <direction>-0.4 0.2 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Match the MTC demo: a narrow pedestal supports the hollow crate while
         both grippers descend over and close on the two upper side rims. -->
    <model name="box_support_table">
      <static>true</static>
      <pose>0.42 0 0.472 0 0 0</pose>
      <link name="top">
        <collision name="collision">
          <geometry><box><size>0.10 0.20 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.20 0.05</size></box></geometry>
          <material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.38 0.40 0.44 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="carry_box">
      <pose>0.42 0 0.60 0 0 0</pose>
      <allow_auto_disable>false</allow_auto_disable>
      <link name="box_link">
        <inertial>
          <!-- Composite inertia of a 1.5 kg open plastic tote made from a
               10 mm bottom and four 10 mm side walls. -->
          <pose>0 0 -0.0217823 0 0 0</pose>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.0280468</ixx><iyy>0.0129132</iyy><izz>0.0284626</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- These five primitives intentionally mirror addHollowCrate() in
             zhishu_robot_mtc_pick_place. There is no collision volume in the
             open interior and no artificial external handle. -->
        <collision name="bottom_collision">
          <pose>0 0 -0.095 0 0 0</pose>
          <geometry><box><size>0.17 0.35 0.01</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact><ode><kp>50000</kp><kd>200</kd><max_vel>0.02</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <collision name="left_wall_collision">
          <pose>0 0.17 0 0 0 0</pose>
          <geometry><box><size>0.17 0.01 0.20</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><contact><ode><kp>50000</kp><kd>200</kd><max_vel>0.02</max_vel><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <collision name="right_wall_collision">
          <pose>0 -0.17 0 0 0 0</pose>
          <geometry><box><size>0.17 0.01 0.20</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><contact><ode><kp>50000</kp><kd>200</kd><max_vel>0.02</max_vel><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <collision name="front_wall_collision">
          <pose>0.08 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.33 0.20</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><contact><ode><kp>50000</kp><kd>200</kd><max_vel>0.02</max_vel><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>
        <collision name="rear_wall_collision">
          <pose>-0.08 0 0 0 0 0</pose>
          <geometry><box><size>0.01 0.33 0.20</size></box></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction><contact><ode><kp>50000</kp><kd>200</kd><max_vel>0.02</max_vel><min_depth>0.0005</min_depth></ode></contact></surface>
        </collision>

        <visual name="bottom_visual"><pose>0 0 -0.095 0 0 0</pose><geometry><box><size>0.17 0.35 0.01</size></box></geometry><material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
        <visual name="left_wall_visual"><pose>0 0.17 0 0 0 0</pose><geometry><box><size>0.17 0.01 0.20</size></box></geometry><material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
        <visual name="right_wall_visual"><pose>0 -0.17 0 0 0 0</pose><geometry><box><size>0.17 0.01 0.20</size></box></geometry><material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
        <visual name="front_wall_visual"><pose>0.08 0 0 0 0 0</pose><geometry><box><size>0.01 0.33 0.20</size></box></geometry><material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
        <visual name="rear_wall_visual"><pose>-0.08 0 0 0 0 0</pose><geometry><box><size>0.01 0.33 0.20</size></box></geometry><material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.55 0.58 0.60 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
