<?xml version="1.0"?>
<sdf version="1.9">
  <world name="pallet_bin_15kg">
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>
    <physics name="pallet_bin_15kg_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.92 0.94 0.98 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.58 0.60 0.62 1</ambient><diffuse>0.68 0.70 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- STEP baifang.stp: pallet 1200 x 1200 x 150 mm. The pallet near edge is
         x=0.434 m, exactly 0.200 m in front of the robot base collision front
         (x ~= 0.234 m) at the initial base pose. -->
    <model name="source_pallet">
      <static>true</static>
      <pose>1.034 0 0 0 0 0</pose>
      <link name="pallet_link">
        <collision name="collision">
          <pose>0 0 0.075 0 0 0</pose>
          <geometry><box><size>1.20 1.20 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0.075 0 0 0</pose>
          <geometry><box><size>1.20 1.20 0.15</size></box></geometry>
          <material><ambient>0.36 0.28 0.16 1</ambient><diffuse>0.55 0.40 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_box_r0_c0">
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_nested_model_pose>false</publish_nested_model_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>
      <!-- Restore the first tote to its default CAD centre, inset from the pallet edge. -->
      <pose>0.704355 -0.400617 0.224000 0 0 0</pose>
      <link name="box_link">

        <inertial>
          <mass>15.0</mass>
          <inertia><ixx>0.22738</ixx><iyy>0.13988</iyy><izz>0.31250</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <!-- The first tote is the extraction target.  Use a measured plastic
             contact coefficient so a 15 kg load can slide once the hook is
             seated; the remaining eight totes keep the conservative default. -->
        <collision name="bottom"><pose>0 0 -0.068 0 0 0</pose><geometry><box><size>0.30 0.40 0.012</size></box></geometry><surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface></collision>
        <collision name="front"><pose>0.145 0 0 0 0 0</pose><geometry><box><size>0.010 0.38 0.148</size></box></geometry><surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface></collision>
        <collision name="rear"><pose>-0.145 0 0 0 0 0</pose><geometry><box><size>0.010 0.38 0.148</size></box></geometry><surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface></collision>
        <!-- Continuous side walls: the CAD handle notch is filled for this
             grasp test, so there is no opening to enter. -->
        <collision name="left_wall_lower"><pose>0 0.195 -0.015 0 0 0</pose><geometry><box><size>0.30 0.010 0.106</size></box></geometry></collision>
        <collision name="left_wall_upper_a"><pose>-0.105 0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry></collision>
        <collision name="left_wall_upper_center"><pose>0 0.195 0.056 0 0 0</pose><geometry><box><size>0.120 0.010 0.036</size></box></geometry></collision>
        <collision name="left_wall_upper_b"><pose>0.105 0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry></collision>
        <collision name="right_wall_lower"><pose>0 -0.195 -0.015 0 0 0</pose><geometry><box><size>0.30 0.010 0.106</size></box></geometry></collision>
        <collision name="right_wall_upper_a"><pose>-0.105 -0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry></collision>
        <collision name="right_wall_upper_center"><pose>0 -0.195 0.056 0 0 0</pose><geometry><box><size>0.120 0.010 0.036</size></box></geometry></collision>
        <collision name="right_wall_upper_b"><pose>0.105 -0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry></collision>
        <!-- Simplified flush side-handle rails; kept inside the 0.40 m box envelope so adjacent CAD-spaced totes do not overlap at startup. -->
        <collision name="left_handle"><pose>0 0.195 0.038 0 0 0</pose><geometry><box><size>0.12 0.006 0.006</size></box></geometry><surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface></collision>
        <collision name="right_handle"><pose>0 -0.195 0.038 0 0 0</pose><geometry><box><size>0.12 0.006 0.006</size></box></geometry><surface><friction><ode><mu>0.20</mu><mu2>0.20</mu2></ode></friction></surface></collision>
        <visual name="bottom_visual"><pose>0 0 -0.068 0 0 0</pose><geometry><box><size>0.30 0.40 0.012</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="front_visual"><pose>0.145 0 0 0 0 0</pose><geometry><box><size>0.010 0.38 0.148</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="rear_visual"><pose>-0.145 0 0 0 0 0</pose><geometry><box><size>0.010 0.38 0.148</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="left_visual_lower"><pose>0 0.195 -0.015 0 0 0</pose><geometry><box><size>0.30 0.010 0.106</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="left_visual_upper_a"><pose>-0.105 0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="left_visual_upper_center"><pose>0 0.195 0.056 0 0 0</pose><geometry><box><size>0.120 0.010 0.036</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="left_visual_upper_b"><pose>0.105 0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="right_visual_lower"><pose>0 -0.195 -0.015 0 0 0</pose><geometry><box><size>0.30 0.010 0.106</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="right_visual_upper_a"><pose>-0.105 -0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="right_visual_upper_center"><pose>0 -0.195 0.056 0 0 0</pose><geometry><box><size>0.120 0.010 0.036</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="right_visual_upper_b"><pose>0.105 -0.195 0.056 0 0 0</pose><geometry><box><size>0.090 0.010 0.036</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="left_handle_visual"><pose>0 0.195 0.038 0 0 0</pose><geometry><box><size>0.12 0.006 0.006</size></box></geometry><material><ambient>0.01 0.35 0.38 1</ambient><diffuse>0.01 0.45 0.50 1</diffuse></material></visual>
        <visual name="right_handle_visual"><pose>0 -0.195 0.038 0 0 0</pose><geometry><box><size>0.12 0.006 0.006</size></box></geometry><material><ambient>0.01 0.35 0.38 1</ambient><diffuse>0.01 0.45 0.50 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Level extraction deck: once r0_c0 is pulled past the pallet edge,
         this temporary fixture keeps its 15 kg body supported at pallet-top
         height instead of letting gravity tip it back onto the dense stack.
         It is outside the nominal pallet footprint and does not overlap the
         robot base at the calibrated x=0.19 m hook station. -->
    <model name="perimeter_extraction_deck">
      <static>true</static>
      <pose>1.009355 -0.805 0.075 0 0 0</pose>
      <link name="deck_link">
        <collision name="collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>1.25 0.41 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>1.25 0.41 0.15</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_box_r0_c1">
      <pose>0.704355 0.002017 0.224000 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>15.0</mass>
          <inertia><ixx>0.22738</ixx><iyy>0.13988</iyy><izz>0.31250</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
