        <visual name="bottom_visual"><pose>0 0 -0.068 0 0 0</pose><geometry><box><size>0.30 0.40 0.012</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
        <visual name="front_visual"><pose>0.145 0 0 0 0 0</pose><geometry><box><size>0.010 0.38 0.148</size></box></geometry><material><ambient>0.02 0.60 0.64 1</ambient><diffuse>0.02 0.78 0.82 1</diffuse></material></visual>
