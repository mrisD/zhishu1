<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="zhishu_robot_right_arm_ros2_control" params="name initial_positions_file use_gazebo:=false use_fake_hardware:=true enable_motors_on_activate:=true">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_gazebo}">
                    <xacro:if value="${use_fake_hardware}">
                        <plugin>mock_components/GenericSystem</plugin>
                        <param name="calculate_dynamics">true</param>
                    </xacro:if>
                    <xacro:unless value="${use_fake_hardware}">
                        <plugin>es_motor_hardware/EsMotorHardwareInterface</plugin>
                    </xacro:unless>
                </xacro:unless>
                <!-- IgH EtherCAT / GH1 SERVOPACK defaults. Per-joint params below can override these. -->
                <param name="cycle_ns">1000000</param>
                <param name="enable_dc">true</param>
                <param name="assign_activate">0x0300</param>
                <!-- Trigger SYNC0 halfway through the 1 ms application cycle. -->
                <param name="sync0_shift_ns">500000</param>
                <param name="select_dc_reference_clock">true</param>
                <param name="dc_reference_alias">0</param>
                <param name="dc_reference_slave_position">0</param>
                <param name="enable_realtime">true</param>
                <param name="realtime_priority">85</param>
                <param name="realtime_cpu">5</param>
                <!-- In CSP mode the 1 kHz ros2_control target is already limited;
                     forward it directly instead of applying a second software profile. -->
                <param name="csp_direct_position_commands">true</param>
                <!-- On-demand 1 kHz PDO capture uses a lock-free ring and a
                     non-realtime CSV writer. 16384 cycles tolerate a 16 s disk stall. -->
                <param name="pdo_diagnostics_buffer_cycles">16384</param>
                <!-- Capture a bounded 20 s startup window even if the ROS service
                     executor is unavailable. This avoids unbounded disk growth. -->
                <param name="pdo_diagnostics_auto_start">true</param>
                <param name="pdo_diagnostics_max_cycles">20000</param>
                <param name="enable_motors_on_activate">${enable_motors_on_activate}</param>
                <param name="master_index">1</param>
                <param name="alias">0</param>
                <param name="vendor_id">0x00206688</param>
                <param name="product_code">0x26483052</param>
                <param name="configure_sdo">true</param>
                <param name="configure_pdos">true</param>
                <!-- Keep TxPDO index 0x1A01, but remap it to include the ESI
                     feedback objects 0x606C (velocity) and 0x6077 (torque). -->
                <param name="enable_velocity_torque_feedback">true</param>
                <!-- GH1 manual units: 0x606C = 0.1 motor RPM/count;
                     0x6077 = 1/10000 rated current/count. -->
                <param name="velocity_raw_rpm_per_count">0.1</param>
                <param name="torque_raw_full_scale">10000.0</param>
                <param name="mode_of_operation">8</param>
                <param name="auto_enable">false</param>
                <param name="counts_per_rev">131072.0</param>
                <param name="max_velocity_counts_s">8000.0</param>
                <param name="max_accel_counts_s2">20000.0</param>
                <param name="target_tolerance_counts">20</param>
                <param name="joint_sign">1.0</param>
                <param name="position_offset_rad">0.0</param>
                <!-- Battery-less encoders retain only the single-turn phase.
                     Recover a continuous ROS position branch on activation. -->
                <param name="position_wraparound">true</param>
                <!-- Only snap tiny reported-position excursions that are just outside
                     an explicitly configured physical joint limit. 0.005 rad ~= 0.286 deg. -->
                <param name="joint_limit_snap_tolerance_rad">0.005</param>
            </hardware>

            

            <!-- right_arm -->
            <joint name="right_shoulder_pitch_joint">
                <param name="use_ethercat">true</param>
                <!-- Midpoint of [-0.90757, 3.0543] selects the valid branch. -->
                <param name="position_wrap_reference_rad">1.073365</param>
                <param name="motor_name">right_arm_motor_0</param>
                <param name="slave_position">0</param>
                <param name="motor_model">GH32A1-101-DBE-R</param>
                <param name="reduction_ratio">101.0</param>
                <param name="rated_torque_nm">178.0</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_shoulder_pitch_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="velocity_raw"/>
                <state_interface name="torque_raw"/>
            </joint>
            <joint name="right_shoulder_roll_joint">
                <param name="use_ethercat">true</param>
                <param name="motor_name">right_arm_motor_1</param>
                <param name="slave_position">1</param>
                <param name="motor_model">GH32A1-101-DBE-R</param>
                <param name="reduction_ratio">101.0</param>
                <param name="rated_torque_nm">178.0</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_shoulder_roll_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="velocity_raw"/>
                <state_interface name="torque_raw"/>
            </joint>
            <joint name="right_shoulder_yaw_joint">
                <param name="use_ethercat">true</param>
                <param name="motor_name">right_arm_motor_2</param>
                <param name="slave_position">2</param>
                <param name="motor_model">GH20A1-101-D0E-R</param>
                <param name="reduction_ratio">101.0</param>
                <param name="rated_torque_nm">52.0</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_shoulder_yaw_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="velocity_raw"/>
                <state_interface name="torque_raw"/>
            </joint>
            <joint name="right_elbow_pitch_joint">
                <param name="use_ethercat">true</param>
                <!-- URDF lower limit is 0 rad. Absorb only tiny negative encoder zero errors. -->
                <param name="snap_lower_limit_rad">0.0</param>
                <param name="motor_name">right_arm_motor_3</param>
                <param name="slave_position">3</param>
                <param name="motor_model">GH17A1-101-D0E-R</param>
                <param name="reduction_ratio">101.0</param>
                <param name="rated_torque_nm">31.0</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_elbow_pitch_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="velocity_raw"/>
                <state_interface name="torque_raw"/>
            </joint>
            <joint name="right_wrist_yaw_joint">
                <param name="use_ethercat">true</param>
                <param name="motor_name">right_arm_motor_4</param>
                <param name="slave_position">4</param>
                <param name="motor_model">GH14A1-101-D0E-R</param>
                <param name="reduction_ratio">101.0</param>
                <param name="rated_torque_nm">10.0</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_wrist_yaw_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="velocity_raw"/>
                <state_interface name="torque_raw"/>
            </joint>
            <joint name="right_wrist_pitch_joint">
                <param name="use_ethercat">true</param>
                <param name="motor_name">right_arm_motor_5</param>
                <param name="slave_position">5</param>
                <param name="motor_model">GH14A1-101-D0E-R</param>
                <param name="reduction_ratio">101.0</param>
                <param name="rated_torque_nm">10.0</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_wrist_pitch_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="velocity_raw"/>
                <state_interface name="torque_raw"/>
            </joint>
            <joint name="right_wrist_roll_joint">
                <param name="use_ethercat">true</param>
                <param name="motor_name">right_arm_motor_6</param>
                <param name="slave_position">6</param>
                <param name="motor_model">GH11A1-101-D0E-R</param>
                <param name="reduction_ratio">101.0</param>
                <param name="rated_torque_nm">4.8</param>
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_wrist_roll_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="velocity_raw"/>
                <state_interface name="torque_raw"/>
            </joint>

         
            <!-- <joint name="waist_up_down_joint">
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['waist_up_down_joint']}</param>
                </state_interface>
            </joint>
            <joint name="waist_pitch_joint">
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['waist_pitch_joint']}</param>
                </state_interface>
            </joint>
            <joint name="head_yaw_joint">
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['head_yaw_joint']}</param>
                </state_interface>
            </joint>
            <joint name="head_pitch_joint">
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['head_pitch_joint']}</param>
                </state_interface>
            </joint>
            <joint name="left_wheel_joint">
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['left_wheel_joint']}</param>
                </state_interface>
            </joint>
            <joint name="right_wheel_joint">
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['right_wheel_joint']}</param>
                </state_interface>
            </joint> -->
        </ros2_control>
    </xacro:macro>
</robot>
