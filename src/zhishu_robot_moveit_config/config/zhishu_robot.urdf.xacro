<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zhishu_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <xacro:arg name="use_gazebo" default="false" />
    <xacro:arg name="use_fake_hardware" default="true" />
    <xacro:arg name="left_arm_use_fake_hardware" default="$(arg use_fake_hardware)" />
    <xacro:arg name="right_arm_use_fake_hardware" default="$(arg use_fake_hardware)" />
    <xacro:arg name="torso_head_use_fake_hardware" default="$(arg use_fake_hardware)" />
    <xacro:arg name="enable_left_arm_hardware" default="true" />
    <xacro:arg name="enable_right_arm_hardware" default="true" />
    <xacro:arg name="enable_torso_head_hardware" default="false" />
    <xacro:arg name="enable_motors_on_activate" default="true" />
    <xacro:arg name="torso_head_enable_motors_on_activate" default="false" />
    <xacro:arg name="pdo_diagnostics_auto_start" default="true" />
    <xacro:arg name="use_head_camera" default="false" />
    <xacro:arg name="hide_head_pitch_visual" default="false" />
    <xacro:arg name="handeye_target_enabled" default="false" />
    <xacro:arg name="bottle_grasp_sim_enabled" default="false" />
    <xacro:arg name="mobile_base_sim_enabled" default="false" />

    <!-- Import zhishu_robot urdf file -->
    <xacro:include filename="$(find zhishu_robot_description)/urdf/zhishu_robot.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="zhishu_robot.left_arm.ros2_control.xacro" />
    <xacro:include filename="zhishu_robot.right_arm.ros2_control.xacro" />
    <xacro:include filename="zhishu_robot.torso_head.ros2_control.xacro" />
    <xacro:include filename="zhishu_robot.gazebo.ros2_control.xacro" />

    <xacro:unless value="$(arg use_gazebo)">
        <xacro:if value="$(arg enable_left_arm_hardware)">
            <!-- master0 is owned by exactly one EthercatDriver. When torso/head
                 hardware is enabled, merge those three GH1 axes into LeftArmSystem
                 instead of creating a second ros2_control hardware component that
                 would try to ecrt_request_master(0) again. -->
            <xacro:if value="$(arg enable_torso_head_hardware)">
                <xacro:zhishu_robot_left_arm_ros2_control
                    name="LeftArmSystem"
                    initial_positions_file="$(arg initial_positions_file)"
                    use_fake_hardware="$(arg left_arm_use_fake_hardware)"
                    enable_motors_on_activate="$(arg enable_motors_on_activate)"
                    pdo_diagnostics_auto_start="$(arg pdo_diagnostics_auto_start)"
                    include_torso_head_state_joints="false"
                    include_torso_head_ethercat_joints="true"/>
            </xacro:if>
            <xacro:unless value="$(arg enable_torso_head_hardware)">
                <xacro:zhishu_robot_left_arm_ros2_control
                    name="LeftArmSystem"
                    initial_positions_file="$(arg initial_positions_file)"
                    use_fake_hardware="$(arg left_arm_use_fake_hardware)"
                    enable_motors_on_activate="$(arg enable_motors_on_activate)"
                    pdo_diagnostics_auto_start="$(arg pdo_diagnostics_auto_start)"
                    include_torso_head_state_joints="true"
                    include_torso_head_ethercat_joints="false"/>
            </xacro:unless>
        </xacro:if>

        <xacro:if value="$(arg enable_right_arm_hardware)">
            <xacro:zhishu_robot_right_arm_ros2_control
                name="RightArmSystem"
                initial_positions_file="$(arg initial_positions_file)"
                use_fake_hardware="$(arg right_arm_use_fake_hardware)"
                enable_motors_on_activate="$(arg enable_motors_on_activate)"
                pdo_diagnostics_auto_start="$(arg pdo_diagnostics_auto_start)"/>
        </xacro:if>

        <!-- Standalone torso/head mode is still available when the left-arm
             hardware component is disabled. In the normal combined topology,
             LeftArmSystem already owns these three joints on master0. -->
        <xacro:if value="$(arg enable_torso_head_hardware)">
            <xacro:unless value="$(arg enable_left_arm_hardware)">
                <xacro:zhishu_robot_torso_head_ros2_control
                    name="TorsoHeadSystem"
                    initial_positions_file="$(arg initial_positions_file)"
                    use_fake_hardware="$(arg torso_head_use_fake_hardware)"
                    enable_motors_on_activate="$(arg torso_head_enable_motors_on_activate)"
                    pdo_diagnostics_auto_start="$(arg pdo_diagnostics_auto_start)"/>
            </xacro:unless>
        </xacro:if>
    </xacro:unless>

    <xacro:if value="$(arg use_gazebo)">
        <xacro:zhishu_robot_gazebo_ros2_control
            name="GazeboSystem"
            initial_positions_file="$(arg initial_positions_file)"/>
        <gazebo>
            <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find zhishu_robot_moveit_config)/config/ros2_controllers.yaml</parameters>
                <parameters>$(find zhishu_robot_moveit_config)/config/gazebo_controller_manager.yaml</parameters>
                <!-- Hold all joints at their configured initial positions while
                     the admittance launch loads and atomically activates controllers. -->
                <hold_joints>true</hold_joints>
                <!-- gz_ros2_control scales position error by update_rate;
                     a sub-unit gain damps discrete contact tracking. -->
                <position_proportional_gain>0.2</position_proportional_gain>
            </plugin>
            <xacro:if value="$(arg mobile_base_sim_enabled)">
                <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
                    <publish_model_pose>true</publish_model_pose>
                    <publish_link_pose>false</publish_link_pose>
                    <use_pose_vector_msg>false</use_pose_vector_msg>
                    <update_frequency>20</update_frequency>
                </plugin>
                <!-- Simulation-only mobile base. The wheel joints are state-only in
                     gz_ros2_control, so DiffDrive is the sole wheel command writer. -->
                <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
                    <left_joint>left_wheel_joint</left_joint>
                    <right_joint>right_wheel_joint</right_joint>
                    <wheel_separation>0.35</wheel_separation>
                    <wheel_radius>0.0858</wheel_radius>
                    <topic>/cmd_vel</topic>
                    <odom_topic>/odom</odom_topic>
                    <tf_topic>/tf</tf_topic>
                    <frame_id>odom</frame_id>
                    <child_frame_id>base_footprint</child_frame_id>
                    <odom_publish_frequency>50</odom_publish_frequency>
                </plugin>
            </xacro:if>
            <xacro:if value="$(arg bottle_grasp_sim_enabled)">
                <!-- Contact determines closure timing; this simulation-only
                     joint prevents numerical slip during the lift. -->
                <plugin filename="gz-sim-detachable-joint-system"
                        name="gz::sim::systems::DetachableJoint">
                    <parent_link>gripper_base_link</parent_link>
                    <child_model>bottle</child_model>
                    <child_link>bottle_link</child_link>
                    <detach_topic>/bottle_grasp/detach</detach_topic>
                    <attach_topic>/bottle_grasp/attach</attach_topic>
                    <output_topic>/bottle_grasp/attached</output_topic>
                </plugin>
            </xacro:if>
        </gazebo>
        <!-- Link-specific extensions must be robot-level siblings, not nested
             in the model-level plugin gazebo tag: sdformat otherwise ignores
             these friction values and copies them as unsupported children. -->
        <xacro:if value="$(arg mobile_base_sim_enabled)">
            <gazebo reference="left_wheel_link"><mu1>8.0</mu1><mu2>8.0</mu2><kp>1000000.0</kp><kd>100.0</kd></gazebo>
            <gazebo reference="right_wheel_link"><mu1>8.0</mu1><mu2>8.0</mu2><kp>1000000.0</kp><kd>100.0</kd></gazebo>
            <!-- Candidate rubber pads: still require physical calibration. -->
            <gazebo reference="gripper_left_finger_link"><mu1>3.0</mu1><mu2>3.0</mu2></gazebo>
            <gazebo reference="gripper_right_finger_link"><mu1>3.0</mu1><mu2>3.0</mu2></gazebo>
            <gazebo reference="left_gripper_left_finger_link"><mu1>3.0</mu1><mu2>3.0</mu2></gazebo>
            <gazebo reference="left_gripper_right_finger_link"><mu1>3.0</mu1><mu2>3.0</mu2></gazebo>
            <xacro:macro name="pallet_contact_sensor" params="link">
                <gazebo reference="${link}">
                    <sensor name="${link}_contact" type="contact">
                        <always_on>true</always_on><update_rate>50</update_rate>
                        <topic>/pallet_contacts/${link}</topic>
                        <contact><collision>${link}_collision</collision></contact>
                    </sensor>
                </gazebo>
            </xacro:macro>
            <xacro:pallet_contact_sensor link="right_shoulder_pitch_link"/>
            <xacro:pallet_contact_sensor link="right_elbow_pitch_link"/>
            <xacro:pallet_contact_sensor link="gripper_left_finger_link"/>
            <xacro:pallet_contact_sensor link="gripper_right_finger_link"/>
        </xacro:if>
    </xacro:if>
</robot>
