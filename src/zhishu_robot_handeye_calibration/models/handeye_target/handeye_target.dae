<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor><authoring_tool>Zhishu 7x5 ChArUco hand-eye calibration</authoring_tool></contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_images>
    <image id="aruco-grid-image"><init_from>model://zhishu_robot_handeye_calibration/models/handeye_target/aruco_grid.png</init_from></image>
  </library_images>
  <library_effects>
    <effect id="aruco-grid-effect">
      <profile_COMMON>
        <newparam sid="surface"><surface type="2D"><init_from>aruco-grid-image</init_from></surface></newparam>
        <newparam sid="sampler"><sampler2D><source>surface</source></sampler2D></newparam>
        <technique sid="common">
          <lambert><diffuse><texture texture="sampler" texcoord="UVSET0"/></diffuse></lambert>
        </technique>
        <extra><technique profile="GOOGLEEARTH"><double_sided>1</double_sided></technique></extra>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="aruco-grid-material"><instance_effect url="#aruco-grid-effect"/></material>
  </library_materials>
  <library_geometries>
    <geometry id="board-geometry">
      <mesh>
        <source id="board-positions">
          <float_array id="board-positions-array" count="12">0 -0.115 -0.085 0 0.115 -0.085 0 0.115 0.085 0 -0.115 0.085</float_array>
          <technique_common><accessor source="#board-positions-array" count="4" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="board-normals">
          <float_array id="board-normals-array" count="3">1 0 0</float_array>
          <technique_common><accessor source="#board-normals-array" count="1" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common>
        </source>
        <source id="board-uv">
          <float_array id="board-uv-array" count="8">0 0 1 0 1 1 0 1</float_array>
          <technique_common><accessor source="#board-uv-array" count="4" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common>
        </source>
        <vertices id="board-vertices"><input semantic="POSITION" source="#board-positions"/></vertices>
        <triangles count="2" material="aruco-grid-material">
          <input semantic="VERTEX" source="#board-vertices" offset="0"/>
          <input semantic="NORMAL" source="#board-normals" offset="1"/>
          <input semantic="TEXCOORD" source="#board-uv" offset="2" set="0"/>
          <p>0 0 0 1 0 1 2 0 2 0 0 0 2 0 2 3 0 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene">
      <node id="board"><instance_geometry url="#board-geometry"><bind_material><technique_common><instance_material symbol="aruco-grid-material" target="#aruco-grid-material"><bind_vertex_input semantic="UVSET0" input_semantic="TEXCOORD" input_set="0"/></instance_material></technique_common></bind_material></instance_geometry></node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
