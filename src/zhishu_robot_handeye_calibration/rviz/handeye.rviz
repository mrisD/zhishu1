Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Name: MotionPlanning
      Planning Request:
        Planning Group: left_arm
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: HandEye Sample Poses
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /handeye_calibration/sample_markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: HandEye Detection Image
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /handeye_calibration/annotated_image
      Transport Hint: raw
      Value: true
    - Class: moveit_rviz_plugin/HandEyeCalibration
      ArUco dictionary: DICT_4X4_50
      Enabled: true
      Name: HandEyeCalibration
      Rx: 0.0
      Ry: 0.0
      Rz: 0.0
      Tx: 0.0
      Ty: 0.0
      Tz: 0.0
      base: base_link
      eef: left_gripper_tcp
      group: left_arm
      image_topic: /camera_head/color/image_raw
      marker border (bits): 1
      longest board side (m): 0.21
      margin size (px): 0
      marker size (px): 220
      measured marker size (m): 0.022
      object: handeye_target
      sensor: head_camera_optical_frame
      sensor_mount_type: 0
      solver: Horaud1995
      square size (px): 300
      squares, X: 7
      squares, Y: 5
      target_type: HandEyeTarget/Charuco
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.3
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.8
      Pitch: 0.45
      Yaw: 2.9
Window Geometry:
  Height: 900
  Width: 1500
