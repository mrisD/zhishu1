<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zhishu_robot_handeye_calibration</name>
  <version>0.1.0</version>
  <description>Eye-to-Hand calibration simulation for the Zhishu robot head camera.</description>
  <maintainer email="zhul@dcloud.com">zhul</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>zhishu_robot_commander_cpp</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_calibration_gui</exec_depend>
  <exec_depend>moveit_calibration_plugins</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>zhishu_robot_gazebo</exec_depend>
  <exec_depend>zhishu_robot_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
